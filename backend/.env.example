# Variables de entorno del backend — NO subir al repositorio (ver .gitignore)

# Puerto del servidor (por defecto 3000)
PORT=3000

# URL del frontend (para CORS). En producción: https://abonapp.tu-dominio.com
FRONTEND_URL=http://localhost:3001

# Secreto de sesión — cámbialo en producción por una cadena larga y aleatoria
SESSION_SECRET=cambia-este-secreto-en-produccion

# true en producción (HTTPS/CloudFront). En local debe quedar en false.
COOKIE_SECURE=false

# Entorno
NODE_ENV=development

# Ruta opcional de la base SQLite (por defecto backend/abonapp.db)
# DB_PATH=./abonapp.db
